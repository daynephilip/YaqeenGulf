# API Keys (Server-side only, configure in Vercel Environment Variables)
GEMINI_API_KEY=
GROQ_API_KEY=

# Shared App Secret between Android app and Proxy (e.g. X-Yaqeen-App-Key header)
YAQEEN_APP_SECRET=

# Persistent Redis Store for Daily Cap & Rate Limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configurable daily kill-switch limit and IP rate limit
DAILY_REQUEST_CAP=100
PER_IP_LIMIT_PER_MINUTE=10
